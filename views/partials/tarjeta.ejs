<div class="col-12 col-md-6 col-xl-4">
  <article class="card content-card shadow-sm h-100">
    <div class="card-top <%= contenido.categoria === 'Serie' ? 'is-serie' : 'is-pelicula' %>">
      <span class="fw-semibold"><%= contenido.categoria %></span>
      <span class="seasons">
        <%= contenido.categoria === 'Serie'
          ? `${contenido.temporadas} ${contenido.temporadas === 1 ? 'temporada' : 'temporadas'}`
          : 'Película' %>
      </span>
    </div>
    <div class="card-body d-flex flex-column">
      <h2 class="card-title mb-1">
        <a href="/contenido/<%= contenido.id %>" class="stretched-link text-decoration-none text-dark">
          <%= contenido.titulo %>
        </a>
      </h2>
      <p class="text-muted small mb-2">
        <%= contenido.sinopsis.length > 110 ? contenido.sinopsis.slice(0, 110) + '…' : contenido.sinopsis %>
      </p>
      <div class="mb-2">
        <% contenido.generos.slice(0, 3).forEach(function (genero) { %>
          <span class="badge rounded-pill genre-badge me-1"><%= genero %></span>
        <% }); %>
        <% if (contenido.generos.length > 3) { %>
          <span class="badge rounded-pill genre-badge">+<%= contenido.generos.length - 3 %></span>
        <% } %>
      </div>
      <div class="mt-auto d-flex justify-content-between align-items-center platforms-line">
        <span><%= contenido.plataformas.length ? contenido.plataformas.join(' · ') : 'Sin plataforma' %></span>
        <span class="<%= contenido.trailer ? 'text-danger' : 'text-muted' %>" title="<%= contenido.trailer ? 'Con trailer' : 'Sin trailer' %>">
          <%= contenido.trailer ? '▶ Trailer' : '—' %>
        </span>
      </div>
    </div>
  </article>
</div>
