<%- include('partials/header') %>

<main class="container py-4">
  <a href="<%= modo === 'editar' ? `/contenido/${id}` : '/' %>" class="btn btn-sm btn-outline-secondary mb-3">
    ← Cancelar y volver
  </a>

  <div class="row justify-content-center">
    <div class="col-12 col-xl-9">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h1 class="h4 fw-bold mb-1"><%= titulo %></h1>
          <p class="text-muted small mb-4">
            Los campos marcados con * son obligatorios. Los datos se guardan directamente en MySQL.
          </p>

          <% if (error) { %>
            <div class="alert alert-danger" role="alert">
              <p class="fw-semibold mb-1"><%= error.message %></p>
              <% if (error.details && error.details.length) { %>
                <ul class="mb-0 ps-3">
                  <% error.details.forEach(function (detalle) { %>
                    <li><%= detalle %></li>
                  <% }); %>
                </ul>
              <% } %>
            </div>
          <% } %>

          <form method="post" action="<%= accion %>" novalidate>
            <div class="row g-3">
              <div class="col-12 col-md-8">
                <label for="campoTitulo" class="form-label">Título *</label>
                <input type="text" class="form-control" id="campoTitulo" name="titulo"
                       maxlength="200" required value="<%= valores.titulo %>">
              </div>
              <div class="col-6 col-md-2">
                <label for="campoTemporadas" class="form-label">Temporadas *</label>
                <input type="number" class="form-control" id="campoTemporadas" name="temporadas"
                       min="0" step="1" required value="<%= valores.temporadas %>">
              </div>
              <div class="col-6 col-md-2">
                <label for="campoCategoria" class="form-label">Categoría *</label>
                <select class="form-select" id="campoCategoria" name="idCategoria" required>
                  <% opciones.categorias.forEach(function (categoria) { %>
                    <option value="<%= categoria.idCategoria %>"
                      <%= Number(valores.idCategoria) === categoria.idCategoria ? 'selected' : '' %>>
                      <%= categoria.nombre %>
                    </option>
                  <% }); %>
                </select>
              </div>

              <div class="col-12">
                <label for="campoSinopsis" class="form-label">Sinopsis *</label>
                <textarea class="form-control" id="campoSinopsis" name="sinopsis" rows="4" required><%= valores.sinopsis %></textarea>
              </div>

              <div class="col-12">
                <label for="campoTrailer" class="form-label">URL del trailer</label>
                <input type="url" class="form-control" id="campoTrailer" name="trailer"
                       placeholder="https://..." value="<%= valores.trailer %>">
                <div class="form-text">Opcional. Dejalo vacío si el contenido no tiene trailer.</div>
              </div>

              <div class="col-12 col-md-6">
                <p class="form-label mb-1">Géneros</p>
                <div class="check-list" role="group" aria-label="Géneros">
                  <% opciones.generos.forEach(function (genero) { %>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" name="generos"
                             id="genero<%= genero.idGenero %>" value="<%= genero.idGenero %>"
                             <%= valores.generos.includes(genero.idGenero) ? 'checked' : '' %>>
                      <label class="form-check-label" for="genero<%= genero.idGenero %>"><%= genero.nombre %></label>
                    </div>
                  <% }); %>
                </div>
              </div>

              <div class="col-12 col-md-6">
                <p class="form-label mb-1">Plataformas</p>
                <div class="check-list" role="group" aria-label="Plataformas">
                  <% opciones.plataformas.forEach(function (plataforma) { %>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" name="plataformas"
                             id="plataforma<%= plataforma.idPlataforma %>" value="<%= plataforma.idPlataforma %>"
                             <%= valores.plataformas.includes(plataforma.idPlataforma) ? 'checked' : '' %>>
                      <label class="form-check-label" for="plataforma<%= plataforma.idPlataforma %>"><%= plataforma.nombre %></label>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
              <button type="submit" class="btn btn-accent">
                <%= modo === 'editar' ? 'Guardar cambios' : 'Crear contenido' %>
              </button>
              <a href="<%= modo === 'editar' ? `/contenido/${id}` : '/' %>" class="btn btn-outline-secondary">Cancelar</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
