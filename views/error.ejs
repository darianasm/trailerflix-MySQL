<%- include('partials/header') %>

<main class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4 text-center">
          <p class="display-6 mb-1"><%= status === 404 ? '🔍' : '⚠️' %></p>
          <h1 class="h3 fw-bold mb-2"><%= titulo %></h1>
          <p class="text-muted mb-3"><%= message %></p>

          <% if (details && details.length) { %>
            <ul class="list-unstyled text-start small bg-light rounded p-3 mb-3">
              <% details.forEach(function (detalle) { %>
                <li class="mb-1">• <%= detalle %></li>
              <% }); %>
            </ul>
          <% } %>

          <div class="d-flex justify-content-center gap-2">
            <a href="/" class="btn btn-accent">Ir al catálogo</a>
            <a href="/api/contenidos" class="btn btn-outline-secondary">Ver JSON</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
