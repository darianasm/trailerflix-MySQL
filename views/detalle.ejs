<%- include('partials/header') %>

<main class="container py-4">
  <a href="/" class="btn btn-sm btn-outline-secondary mb-3">← Volver al catálogo</a>

  <% if (mensaje) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= mensaje %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
  <% } %>

  <div class="row g-4">
    <div class="col-12 col-lg-4">
      <div class="detail-cover h-100 d-flex flex-column">
        <p class="text-uppercase small mb-1 opacity-75"><%= contenido.categoria %></p>
        <h1 class="h3 fw-bold"><%= contenido.titulo %></h1>
        <p class="mb-4 opacity-75">
          <%= contenido.categoria === 'Serie'
            ? `${contenido.temporadas} ${contenido.temporadas === 1 ? 'temporada' : 'temporadas'}`
            : 'Película' %>
        </p>
        <div class="mt-auto">
          <% if (contenido.trailer) { %>
            <a href="<%= contenido.trailer %>" target="_blank" rel="noopener" class="btn btn-accent w-100">
              ▶ Ver trailer
            </a>
          <% } else { %>
            <span class="d-block text-center small opacity-75">Sin trailer disponible</span>
          <% } %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <p class="detail-label mb-1">Sinopsis</p>
          <p><%= contenido.sinopsis %></p>

          <div class="row g-4 mt-1">
            <div class="col-12 col-md-6">
              <p class="detail-label mb-2">Géneros</p>
              <% if (contenido.generos.length) { %>
                <% contenido.generos.forEach(function (genero) { %>
                  <span class="chip"><%= genero %></span>
                <% }); %>
              <% } else { %>
                <span class="text-muted small">Sin géneros asignados</span>
              <% } %>
            </div>
            <div class="col-12 col-md-6">
              <p class="detail-label mb-2">Plataformas</p>
              <% if (contenido.plataformas.length) { %>
                <% contenido.plataformas.forEach(function (plataforma) { %>
                  <span class="chip"><%= plataforma %></span>
                <% }); %>
              <% } else { %>
                <span class="text-muted small">Sin plataformas asignadas</span>
              <% } %>
            </div>
          </div>

          <div class="mt-4">
            <p class="detail-label mb-2">Reparto</p>
            <% if (contenido.reparto.length) { %>
              <p class="mb-0"><%= contenido.reparto.join(', ') %></p>
            <% } else { %>
              <span class="text-muted small">Sin reparto cargado</span>
            <% } %>
          </div>

          <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
            <a href="/contenido/<%= contenido.id %>/editar" class="btn btn-dark">Editar</a>
            <form method="post" action="/contenido/<%= contenido.id %>/eliminar"
                  onsubmit="return confirm('¿Eliminar este contenido?');">
              <button type="submit" class="btn btn-outline-danger">Eliminar</button>
            </form>
            <a href="/api/contenidos/<%= contenido.id %>" target="_blank" rel="noopener"
               class="btn btn-outline-secondary ms-auto">Ver JSON</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
