<%- include('partials/header') %>

<header class="hero">
  <div class="container">
    <h1>Catálogo Trailerflix</h1>
    <p class="mb-3">
      Películas y series almacenadas en MySQL y renderizadas en el servidor con EJS
      a partir de los datos obtenidos con Sequelize. Buscá, agregá, editá y eliminá contenidos.
    </p>
    <div class="d-flex flex-wrap gap-2">
      <span class="stat-pill"><strong><%= estadisticas.total %></strong> contenidos</span>
      <span class="stat-pill"><strong><%= estadisticas.peliculas %></strong> películas</span>
      <span class="stat-pill"><strong><%= estadisticas.series %></strong> series</span>
    </div>
  </div>
</header>

<main class="container py-4">
  <% if (mensaje) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= mensaje %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
  <% } %>

  <form method="get" action="/" class="card border-0 shadow-sm filter-card">
    <div class="card-body">
      <div class="row g-2 align-items-end">
        <div class="col-12 col-lg-4">
          <label for="filtroTitulo" class="form-label">Buscar por título</label>
          <input type="search" class="form-control" id="filtroTitulo" name="titulo"
                 value="<%= filtros.titulo %>" placeholder="Ej.: The Crown, Duna, Friends...">
        </div>
        <div class="col-6 col-lg-2">
          <label for="filtroCategoria" class="form-label">Categoría</label>
          <select class="form-select" id="filtroCategoria" name="categoria">
            <option value="">Todas</option>
            <% opciones.categorias.forEach(function (categoria) { %>
              <option value="<%= categoria.nombre %>" <%= filtros.categoria === categoria.nombre ? 'selected' : '' %>>
                <%= categoria.nombre %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-6 col-lg-2">
          <label for="filtroGenero" class="form-label">Género</label>
          <select class="form-select" id="filtroGenero" name="genero">
            <option value="">Todos</option>
            <% opciones.generos.forEach(function (genero) { %>
              <option value="<%= genero.nombre %>" <%= filtros.genero === genero.nombre ? 'selected' : '' %>>
                <%= genero.nombre %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-6 col-lg-2">
          <label for="filtroPlataforma" class="form-label">Plataforma</label>
          <select class="form-select" id="filtroPlataforma" name="plataforma">
            <option value="">Todas</option>
            <% opciones.plataformas.forEach(function (plataforma) { %>
              <option value="<%= plataforma.nombre %>" <%= filtros.plataforma === plataforma.nombre ? 'selected' : '' %>>
                <%= plataforma.nombre %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-6 col-lg-2 d-flex gap-2">
          <button type="submit" class="btn btn-dark flex-grow-1">Filtrar</button>
          <a href="/" class="btn btn-outline-secondary" title="Limpiar filtros">Limpiar</a>
        </div>
      </div>

      <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
        <div class="form-check form-switch mb-0">
          <input class="form-check-input" type="checkbox" id="filtroTrailer" name="trailer" value="true"
                 <%= filtros.trailer ? 'checked' : '' %>>
          <label class="form-check-label" for="filtroTrailer">Solo con trailer</label>
        </div>
        <select class="form-select form-select-sm w-auto" name="orden" aria-label="Ordenar por">
          <option value="id" <%= filtros.orden === 'id' ? 'selected' : '' %>>Ordenar por id</option>
          <option value="titulo" <%= filtros.orden === 'titulo' ? 'selected' : '' %>>Ordenar por título</option>
          <option value="temporadas" <%= filtros.orden === 'temporadas' ? 'selected' : '' %>>Ordenar por temporadas</option>
        </select>
        <span class="text-muted small ms-auto"><%= contenidos.length %> resultado<%= contenidos.length === 1 ? '' : 's' %></span>
      </div>
    </div>
  </form>

  <% if (contenidos.length) { %>
    <div class="row g-4 mt-1">
      <% contenidos.forEach(function (contenido) { %>
        <%- include('partials/tarjeta', { contenido: contenido }) %>
      <% }); %>
    </div>
  <% } else { %>
    <div class="text-center py-5 empty">
      <p class="display-6 mb-1">🔍</p>
      <h2 class="h5">No se encontraron contenidos</h2>
      <p class="text-muted mb-3">Probá con otros filtros o agregá un contenido nuevo.</p>
      <a href="/contenido/nuevo" class="btn btn-accent">+ Nuevo contenido</a>
    </div>
  <% } %>
</main>

<%- include('partials/footer') %>
